---
const email = "hello@paperhue.com";
---

<section id="contact" class="section" aria-labelledby="contact-title">
  <h2 id="contact-title">Contact us</h2>
  <a href={`mailto:${email}`} class="mt-4 inline-block text-h3 break-all md:text-h2 text-accent transition-opacity hover:opacity-80">{email}</a>

  <form class="reach" data-reach data-email={email} novalidate>
    <label for="reach-email" class="reach-label">Or leave your email and we'll reach out.</label>
    <div class="reach-row">
      <input id="reach-email" type="email" name="email" placeholder="you@company.com" autocomplete="email" inputmode="email" required />
      <button type="submit">Reach out to me</button>
    </div>
    <p class="reach-status" role="status" aria-live="polite" data-status></p>
  </form>
</section>

<style>
  .reach {
    display: grid;
    gap: 12px;
    max-width: 520px;
    margin-top: 40px;
  }
  .reach-label {
    color: var(--color-secondary);
    font-size: var(--text-small);
  }
  .reach-row {
    display: flex;
    gap: 8px;
    padding: 6px;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.05);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
    transition: box-shadow 0.2s;
  }
  .reach-row:focus-within { box-shadow: inset 0 0 0 2px var(--color-accent); }
  .reach-row input {
    flex: 1;
    min-width: 0;
    padding: 0 16px;
    border: 0;
    background: transparent;
    color: var(--color-white);
    font: inherit;
    font-size: max(16px, var(--text-body));
  }
  .reach-row input:focus { outline: none; }
  .reach-row button {
    padding: 12px 22px;
    border-radius: 9999px;
    background: var(--color-accent);
    color: var(--color-page);
    font: inherit;
    font-size: var(--text-body);
    white-space: nowrap;
    cursor: pointer;
    transition: opacity 0.3s;
  }
  .reach-row button:hover { opacity: 0.9; }
  .reach-status { min-height: 1.4em; font-size: var(--text-small); }
  .reach-status.error { color: #e5484d; }
  .reach-status.ok { color: var(--color-accent); }
  @media (max-width: 479px) {
    .reach-row { flex-direction: column; border-radius: 24px; }
    .reach-row input { padding: 12px 16px; }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-reach]");
  const status = form?.querySelector<HTMLElement>("[data-status]");
  const input = form?.querySelector<HTMLInputElement>("input");

  if (form && status && input) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const value = input.value.trim();
      if (!value || !input.checkValidity()) {
        status.className = "reach-status error";
        status.textContent = "Please enter a valid email address.";
        input.focus();
        return;
      }
      const body = `Please reach out to me at ${value}.`;
      location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent("Please get in touch")}&body=${encodeURIComponent(body)}`;
      status.className = "reach-status ok";
      status.textContent = "Thanks! Your email app should open. Send it and we'll reach out.";
    });
  }
</script>
