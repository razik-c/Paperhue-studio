---
import Logo from "./Logo.astro";

const email = "hello@paperhue.com";
const phone = "+971 00 000 0000";
const address = ["Office address line", "City", "Country"];

const nav = [
  { href: "#services", label: "Services" },
  { href: "#work", label: "Work" },
  { href: "#why-us", label: "Why us" },
  { href: "#contact", label: "Contact" },
];
const socials = [
  { href: "#", label: "Instagram" },
  { href: "#", label: "LinkedIn" },
  { href: "#", label: "Behance" },
];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container mx-auto px-5 sm:px-6">
    <div class="foot-main">
      <Logo size="lg" />

      <div class="foot-cols">
        <nav aria-label="Footer">
          <p class="foot-head">Navigation</p>
          <ul>
            {nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </nav>

        <div>
          <p class="foot-head">Contact</p>
          <address>
            {address.map((line) => <span>{line}</span>)}
          </address>
          <ul class="mt-5">
            <li><a href={`mailto:${email}`}>{email}</a></li>
            <li><a href={`tel:${phone.replace(/\s/g, "")}`}>{phone}</a></li>
          </ul>
        </div>

        <div>
          <p class="foot-head">Socials</p>
          <ul>
            {socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a></li>)}
          </ul>
        </div>
      </div>

      <a href="#top" class="foot-top" aria-label="Back to top" data-to-top>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 19V5M6 11l6-6 6 6" />
        </svg>
      </a>
    </div>

    <div class="foot-bar">
      <p>© {year} Paperhue Studio</p>
      <div class="foot-legal">
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms &amp; Conditions</a>
      </div>
      <p>Designed &amp; built by Paperhue Studio</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 0;
    border-top: 1px solid rgb(255 255 255 / 0.1);
  }

  .foot-main {
    position: relative;
    display: grid;
    gap: 48px;
    padding-block: calc(var(--space-section) * 0.75);
  }
  @media (min-width: 1024px) {
    .foot-main {
      grid-template-columns: 5fr 7fr;
      align-items: start;
      padding-block: calc(var(--space-section) * 0.75);
    }
  }


  .foot-cols {
    display: grid;
    gap: 40px 32px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 768px) {
    .foot-cols { grid-template-columns: repeat(3, minmax(0, 1fr)); padding-right: 64px; }
  }

  .foot-head {
    margin-bottom: 16px;
    color: var(--color-white);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
  }
  .foot-cols ul { display: grid; gap: 8px; }
  .foot-cols address {
    display: grid;
    font-style: normal;
  }
  .foot-cols a,
  .foot-cols address {
    color: var(--color-muted);
    font-size: var(--text-body);
    line-height: 1.4;
    overflow-wrap: anywhere;
  }
  .foot-cols a { transition: color 0.2s; }
  .foot-cols a:hover { color: var(--color-accent); }

  .foot-top {
    position: absolute;
    top: calc(var(--space-section) * 0.75);
    right: 0;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.08);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
    color: var(--color-white);
    transition: background 0.3s, color 0.3s, translate 0.3s;
  }
  .foot-top svg { width: 18px; height: 18px; }
  .foot-top:hover { background: var(--color-accent); color: var(--color-page); translate: 0 -3px; box-shadow: none; }
  @media (min-width: 1024px) {
    .foot-top { top: calc(var(--space-section) * 0.75); }
  }

  .foot-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 32px;
    padding-block: 24px 40px;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    color: var(--color-muted);
    font-size: var(--text-small);
  }
  @media (max-width: 640px) {
    .foot-bar { padding-bottom: 112px; }
  }
  .foot-bar p { font-size: inherit; }
  .foot-legal { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .foot-legal a:hover { color: var(--color-primary); }
</style>

<script>
  document.querySelector("[data-to-top]")?.addEventListener("click", (e) => {
    e.preventDefault();
    const smooth = !matchMedia("(prefers-reduced-motion: reduce)").matches;
    scrollTo({ top: 0, behavior: smooth ? "smooth" : "auto" });
  });
</script>
