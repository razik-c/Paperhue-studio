---
interface Props {
  size?: "sm" | "lg";
  class?: string;
}
const { size = "sm", class: className = "pt-8" } = Astro.props;
---

<a href="/" class:list={["logo", size, className]} aria-label="Paperhue Studio, home">
  <span class="logo-main">Paperhue<span class="logo-dot">.</span></span>
  <span class="logo-sub">studio</span>
</a>

<style>
  .logo {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    color: var(--color-white);
    line-height: 1;
    rotate: -6deg;
    transition: rotate 0.5s cubic-bezier(0.3, 1.4, 0.5, 1);
  }
  @media (hover: hover) {
    .logo:hover {
      rotate: -2deg;
    }
  }
  .logo-dot {
    color: var(--color-accent);
  }
  .logo-main {
    font-weight: 700;
    letter-spacing: -0.05em;
  }
  .logo-sub {
    margin-top: 0.15em;
    color: var(--color-secondary);
    opacity: 0.6;
    font-size: 0.42em;
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .sm {
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 1.875rem);
    transform-origin: left center;
    translate: 0 -0.3em;
  }
  .lg {
    font-size: clamp(3.5rem, 2rem + 6vw, 7rem);
  }
  .lg .logo-sub {
    font-size: 0.32em;
    margin-top: 0.2em;
  }
</style>
