---
const steps = [
  {
    title: "Discovery",
    text: "We learn how your business sells today, who your customers are and where the current site is losing them.",
    image: "https://picsum.photos/seed/ph-discovery/900/800",
  },
  {
    title: "Strategy & UX",
    text: "We map the pages, journeys and content that will move visitors from first click to checkout or enquiry.",
    image: "https://picsum.photos/seed/ph-strategy/900/800",
  },
  {
    title: "Design",
    text: "We design a clear, on-brand interface for desktop and mobile, and refine it with you before a line of code is written.",
    image: "https://picsum.photos/seed/ph-design/900/800",
  },
  {
    title: "Development",
    text: "We build it fast, accessible and easy to manage, with the integrations, payments and tools your team needs.",
    image: "https://picsum.photos/seed/ph-build/900/800",
  },
  {
    title: "Testing & launch",
    text: "We test every page for speed, SEO and conversion on real devices, then launch without downtime.",
    image: "https://picsum.photos/seed/ph-launch/900/800",
  },
  {
    title: "Growth & support",
    text: "After launch we keep improving: tracking results, running tests and looking after the site as you grow.",
    image: "https://picsum.photos/seed/ph-growth/900/800",
  },
];
const pad = (n: number) => String(n).padStart(2, "0");
---

<section id="process" class="section" aria-labelledby="process-title">
  <div class="section-head">
    <h2 id="process-title">Our process</h2>
    <p class="lead">Six clear steps from first conversation to a site that keeps getting better after launch.</p>
  </div>

  <ol class="panels" data-panels>
    {steps.map((s, i) => (
      <li class:list={["panel", { "is-active": i === 0 }]}>
        <button type="button" class="panel-btn" aria-expanded={i === 0 ? "true" : "false"}>
          <img src={s.image} alt="" width="900" height="800" loading="lazy" decoding="async" />
          <span class="panel-num">{pad(i + 1)}</span>
          <span class="panel-side">{s.title}</span>
          <span class="panel-body">
            <span class="panel-title">{s.title}</span>
            <span class="panel-text">{s.text}</span>
          </span>
        </button>
      </li>
    ))}
  </ol>
</section>

<style>
  .panels {
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 560px;
  }
  .panel {
    flex: 1 1 0;
    min-height: 0;
    min-width: 0;
    transition: flex-grow 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .panel.is-active { flex-grow: 6; }

  .panel-btn {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 16px;
    background: rgb(255 255 255 / 0.05);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
    color: var(--color-white);
    text-align: left;
    cursor: pointer;
  }
  .panel-btn img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.18;
    filter: grayscale(1);
    transition: opacity 0.6s, filter 0.6s;
  }
  .panel.is-active img { opacity: 1; filter: none; }
  .panel-btn::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.78), transparent 65%);
    opacity: 0;
    transition: opacity 0.6s;
  }
  .panel.is-active .panel-btn::after { opacity: 1; }

  .panel-num {
    position: absolute;
    left: 20px;
    top: 18px;
    z-index: 1;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--text-label--letter-spacing);
  }
  .panel-side {
    position: absolute;
    z-index: 1;
    left: 56px;
    top: 50%;
    transform: translateY(-50%);
    font-size: var(--text-lead);
    line-height: 1.1;
    transition: opacity 0.3s;
  }
  .panel.is-active .panel-side { opacity: 0; }
  @media (max-width: 1023px) {
    .panel:not(.is-active) .panel-num { top: 50%; transform: translateY(-50%); }
  }

  .panel-body {
    position: absolute;
    z-index: 1;
    left: 24px;
    right: 24px;
    bottom: 24px;
    display: grid;
    gap: 10px;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.3s, transform 0.3s;
    pointer-events: none;
  }
  .panel.is-active .panel-body {
    opacity: 1;
    transform: none;
    transition: opacity 0.5s 0.25s, transform 0.5s 0.25s;
  }
  .panel-title {
    font-size: var(--text-h3);
    line-height: var(--text-h3--line-height);
    letter-spacing: var(--text-h3--letter-spacing);
  }
  .panel-text {
    max-width: 38ch;
    color: rgb(255 255 255 / 0.8);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
  }

  @media (min-width: 1024px) {
    .panels {
      flex-direction: row;
      height: clamp(360px, 48vh, 460px);
    }
    .panel.is-active { flex-grow: 3.4; }
    .panel-side {
      left: 50%;
      top: auto;
      bottom: 24px;
      writing-mode: vertical-rl;
      transform: translateX(-50%) rotate(180deg);
      white-space: nowrap;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .panel, .panel-btn img, .panel-btn::after, .panel-body { transition: none; }
  }
</style>

<script>
  const items = [...document.querySelectorAll<HTMLElement>("[data-panels] .panel")];
  const hover = matchMedia("(hover: hover)").matches;

  const activate = (el: HTMLElement) => {
    items.forEach((p) => {
      const on = p === el;
      p.classList.toggle("is-active", on);
      p.querySelector("button")?.setAttribute("aria-expanded", String(on));
    });
  };

  items.forEach((p) => {
    const btn = p.querySelector("button");
    btn?.addEventListener("click", () => activate(p));
    btn?.addEventListener("focus", () => activate(p));
    if (hover) p.addEventListener("mouseenter", () => activate(p));
  });
</script>
