---
const services = [
  { title: "Ecommerce", left: ["Storefront", "Checkout", "Catalogue"], right: ["Payments", "Orders", "Inventory"] },
  { title: "Web Development", left: ["Performance", "Design", "Accessibility"], right: ["Search", "Content", "Analytics"] },
  { title: "Custom Software & CRM", left: ["Workflow", "Dashboards", "Automation"], right: ["Pipelines", "Follow-ups", "Reporting"] },
  { title: "AI Agents", left: ["Support", "Sales", "Research"], right: ["Leads", "Booking", "Data"] },
];
const pad = (n: number) => String(n).padStart(2, "0");
---

<section id="services" class="section" aria-labelledby="services-title">
  <div class="section-head">
    <h2 id="services-title">Our services</h2>
    <p class="lead">From a first website to custom software and AI agents, we design, build and look after the digital products your business runs on.</p>
  </div>

  <ul class="svc-list mx-auto max-w-6xl">
    {services.map((s, i) => (
      <li class="svc">
        <a href="#contact" class="svc-row">
          <span class="svc-side svc-left">
            <span class="mono svc-num">({pad(i + 1)})</span>
            <span class="svc-words mono" style={`--n:${s.left.length}`}>{s.left.map((w, j) => <span style={`--i:${j}`}>{w}</span>)}</span>
          </span>
          <span class="svc-title">{s.title}</span>
          <span class="svc-side svc-right">
            <span class="svc-words svc-words-r mono" style={`--n:${s.right.length}`}>{s.right.map((w, j) => <span style={`--i:${j}`}>{w}</span>)}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .mono {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
  }

  .svc + .svc { border-top: 1px solid rgb(255 255 255 / 0.15); }
  .svc-row {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    padding: clamp(20px, 3vw, 36px) 24px;
    color: var(--color-white);
    transition: color 0.4s;
  }
  .svc-row::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: 20px;
    background: var(--color-white);
    opacity: 0;
    scale: 1 0.85;
    transition: opacity 0.4s, scale 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .svc-row > * { position: relative; z-index: 1; }

  .svc-title {
    font-size: var(--text-h2);
    line-height: 1.1;
    letter-spacing: var(--text-h2--letter-spacing);
    text-align: center;
  }

  .svc-side {
    display: grid;
    align-items: center;
    color: var(--color-muted);
    transition: color 0.4s;
  }
  .svc-left { justify-items: end; }
  .svc-right { justify-items: start; }
  .svc-side > * { grid-area: 1 / 1; transition: opacity 0.4s, translate 0.5s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .svc-words {
    display: grid;
    overflow: hidden;
    line-height: 1.6;
  }
  .svc-words > span {
    grid-area: 1 / 1;
    opacity: 0;
    white-space: nowrap;
  }
  .svc-left .svc-words { justify-items: end; }
  .svc-right .svc-words { justify-items: start; }
  @keyframes svc-cycle {
    0% { opacity: 0; transform: translateY(100%); }
    6%, 26% { opacity: 1; transform: none; }
    32%, 100% { opacity: 0; transform: translateY(-100%); }
  }

  .svc-row:hover,
  .svc-row:focus-visible { color: var(--color-page); }
  .svc-row:hover::before,
  .svc-row:focus-visible::before { opacity: 1; scale: 1; }
  .svc-row:hover .svc-side,
  .svc-row:focus-visible .svc-side { color: var(--color-page); }
  .svc-row:hover .svc-words > span,
  .svc-row:focus-visible .svc-words > span {
    animation: svc-cycle calc(var(--n) * 1.4s * 0.9) infinite;
    animation-delay: calc(var(--i) * 1.4s * 0.9);
  }
  .svc-row:hover .svc-words-r > span,
  .svc-row:focus-visible .svc-words-r > span {
    animation-delay: calc(var(--i) * 1.4s * 0.9 + 0.45s);
  }
  .svc-row:hover .svc-num,
  .svc-row:focus-visible .svc-num { opacity: 0; }
  .svc-row:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; border-radius: 20px; }

  @media (max-width: 767px) {
    .svc-row { grid-template-columns: auto 1fr; gap: 14px; padding-inline: 8px; }
    .svc-right { display: none; }
    .svc-title { order: 2; text-align: left; font-size: var(--text-h3); letter-spacing: var(--text-h3--letter-spacing); }
    .svc-left .svc-words { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .svc-row, .svc-row::before, .svc-side > * { transition: none; }
    .svc-row:hover .svc-words > span, .svc-row:focus-visible .svc-words > span { animation: none; }
    .svc-row:hover .svc-words > span:first-child, .svc-row:focus-visible .svc-words > span:first-child { opacity: 1; }
  }
</style>
