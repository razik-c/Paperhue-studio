---
const services = [
  {
    title: "Web Development",
    text: "Modern, responsive websites and web applications built around your business goals.",
    items: ["Business websites", "Web applications", "Ecommerce", "Admin dashboards", "CMS integrations"],
  },
  {
    title: "Mobile Applications",
    text: "Mobile experiences designed for real users and connected to reliable backend systems.",
    items: ["Android", "iOS", "Cross-platform apps", "App APIs", "App maintenance"],
  },
  {
    title: "Custom Software",
    text: "Software built around your workflow instead of forcing your business into a template.",
    items: ["Internal tools", "Workflow tools", "Business platforms", "Automation", "Custom dashboards"],
  },
  {
    title: "Custom CRM",
    text: "A CRM shaped around how you sell to, serve and follow up with your customers.",
    items: ["Customer records", "Sales pipelines", "Follow-ups & reminders", "Team roles & access", "Reporting"],
  },
  {
    title: "Ecommerce",
    text: "Complete ecommerce experiences, from the storefront to the backend.",
    items: ["Storefront development", "Product systems", "Payments", "Orders", "Inventory integrations"],
  },
  {
    title: "Product Development",
    text: "From an early concept to a production-ready digital product.",
    items: ["MVP development", "Product interfaces", "Architecture", "Development"],
  },
  {
    title: "AI Agents",
    text: "AI agents that take on real work for your business, connected to your own data, tools and systems.",
    items: ["Customer support agents", "Lead qualification", "Chat bot assistants"],
  },
];
const pad = (n: number) => String(n).padStart(2, "0");
---

<section id="services" class="py-12 md:py-20" aria-labelledby="services-title">
  <h2 id="services-title" class="text-center">Our services</h2>
  <p class="lead mx-auto mt-4 max-w-xl text-center">From a first website to custom software and AI agents, we design, build and look after the digital products your business runs on.</p>

  <ul class="mx-auto mt-8 max-w-6xl border-t border-white/10 md:mt-12">
    {services.map((s, i) => (
      <li class="svc border-b border-white/10">
        <button class="svc-head" type="button" aria-expanded="false" aria-controls={`svc-${i}`} data-svc>
          <span class="mono svc-num">{pad(i + 1)}</span>
          <span class="svc-title">{s.title}</span>
          <span class="svc-text">{s.text}</span>
          <span class="svc-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 17 17 7M8 7h9v9" />
            </svg>
          </span>
        </button>
        <div id={`svc-${i}`} class="svc-body" role="region" inert>
          <div class="svc-inner">
            <p class="svc-text-mobile">{s.text}</p>
            <ul class="svc-items">
              {s.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .mono {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--text-label--letter-spacing);
  }

  .svc-head {
    display: grid;
    grid-template-columns: 32px 1fr auto;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding-block: 24px;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  @media (min-width: 1024px) {
    .svc-head {
      grid-template-columns: 64px 1fr minmax(0, 360px) 56px;
      gap: 32px;
      padding-block: 36px;
    }
  }
  .svc-num {
    align-self: end;
    padding-bottom: 0.5em;
    color: var(--color-muted);
    transition: color 0.3s;
  }
  .svc-title {
    color: var(--color-white);
    font-size: var(--text-h3);
    line-height: var(--text-h3--line-height);
    letter-spacing: var(--text-h3--letter-spacing);
    transform-origin: left center;
    transition: scale 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), color 0.3s;
  }
  .svc-text {
    display: none;
    max-width: 360px;
    color: var(--color-muted);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
  }
  @media (min-width: 1024px) {
    .svc-text { display: block; }
    .svc-text-mobile { display: none; }
  }
  .svc-icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 9999px;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.15);
    color: var(--color-white);
    transition: background 0.3s, color 0.3s, rotate 0.5s cubic-bezier(0.3, 1.4, 0.5, 1);
  }
  .svc-icon svg { width: 20px; height: 20px; }

  @media (hover: hover) {
    .svc-head:hover .svc-title { scale: 1.08; }
  }
  .svc-head:hover .svc-num,
  .svc-head[aria-expanded="true"] .svc-num { color: var(--color-accent); }
  .svc-head:hover .svc-icon,
  .svc-head[aria-expanded="true"] .svc-icon { background: var(--color-accent); color: var(--color-page); box-shadow: none; }
  .svc-head[aria-expanded="true"] .svc-icon { rotate: 90deg; }
  .svc-head:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; border-radius: 12px; }
  .svc-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .svc.open .svc-body { grid-template-rows: 1fr; }
  .svc-inner {
    overflow: hidden;
    padding-left: 44px;
  }
  @media (min-width: 1024px) {
    .svc-inner { padding-left: 96px; }
  }
  .svc-text-mobile { margin-bottom: 16px; max-width: 36ch; }
  @media (max-width: 480px) {
    .svc-inner { padding-left: 0; }
  }
  .svc-items {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding-bottom: 32px;
  }
  .svc-items li {
    padding: 8px 16px;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.05);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
    color: var(--color-secondary);
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
    opacity: 0;
    translate: 0 10px;
    transition: opacity 0.3s, translate 0.3s;
  }
  .svc.open .svc-items li {
    opacity: 1;
    translate: 0 0;
    transition-duration: 0.5s;
  }
  .svc.open .svc-items li:nth-child(2) { transition-delay: 0.05s; }
  .svc.open .svc-items li:nth-child(3) { transition-delay: 0.1s; }
  .svc.open .svc-items li:nth-child(4) { transition-delay: 0.15s; }
  .svc.open .svc-items li:nth-child(5) { transition-delay: 0.2s; }

  @media (prefers-reduced-motion: reduce) {
    .svc-body, .svc-items li, .svc-title, .svc-icon { transition: none; }
  }
</style>

<script>
  const heads = [...document.querySelectorAll<HTMLButtonElement>("[data-svc]")];
  heads.forEach((head) =>
    head.addEventListener("click", () => {
      const opening = head.getAttribute("aria-expanded") !== "true";
      heads.forEach((h) => {
        const open = h === head && opening;
        h.setAttribute("aria-expanded", String(open));
        h.parentElement!.classList.toggle("open", open);
        (h.nextElementSibling as HTMLElement).inert = !open;
      });
    }),
  );
</script>
