---
const shop = "https://paperhue.com/";
const done = [
  "Custom website",
  "Ecommerce storefront",
  "Mobile-first design",
  "SEO",
  "Speed optimisation",
  "Conversion testing",
  "Checkout & payments",
  "Analytics & tracking",
  "Email automation",
];
---

<section id="why-us" aria-labelledby="why-title" class="section">
  <h2 id="why-title" class="why-title">Most web studios have never run a shop.</h2>

  <p class="why-sub lead">
    We do, every day. <a href={shop} target="_blank" rel="noopener noreferrer">Paperhue.com</a> is our own store, and
    everything we build for you has been tested on real customers of ours first.
  </p>

  <ul class="why-list">
    {done.map((d) => <li>{d}</li>)}
  </ul>

  <a href={shop} target="_blank" rel="noopener noreferrer" class="why-link group">
    Visit paperhue.com
    <span class="why-arrow" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M7 17 17 7M8 7h9v9" />
      </svg>
    </span>
    <span class="sr-only"> (opens in a new tab)</span>
  </a>
</section>

<style>
  .why-title {
    max-width: 16ch;
    color: var(--color-accent);
  }
  .why-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 40px;
    padding: 6px 6px 6px 24px;
    border-radius: 9999px;
    background: var(--color-accent);
    color: var(--color-page);
    font-size: var(--text-body);
    transition: opacity 0.3s;
  }
  .why-arrow {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 9999px;
    background: var(--color-page);
    color: var(--color-accent);
    transition: rotate 0.4s cubic-bezier(0.3, 1.4, 0.5, 1);
  }
  .why-arrow svg { width: 16px; height: 16px; }
  @media (hover: hover) {
    .why-link:hover { opacity: 0.9; }
    .why-link:hover .why-arrow { rotate: 45deg; }
  }
  .why-link:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }

  .why-sub {
    max-width: 40ch;
    margin-top: 24px;
    color: var(--color-primary);
  }
  .why-sub a {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.15em;
  }
  .why-sub a:hover { color: var(--color-accent); }

  .why-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 24px;
    max-width: 880px;
    margin-top: var(--space-head);
    padding-top: 24px;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    color: var(--color-secondary);
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  @media (min-width: 768px) {
    .why-list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
